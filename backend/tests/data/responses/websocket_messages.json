{
  "websocket_messages": {
    "task_update": {
      "type": "task:update",
      "payload": {
        "task_id": "task-123",
        "status": "running",
        "progress": 50,
        "message": "正在扫描..."
      }
    },
    "task_progress": {
      "type": "task:progress",
      "payload": {
        "task_id": "task-123",
        "current_step": 3,
        "total_steps": 10,
        "step_name": "端口扫描"
      }
    },
    "task_completed": {
      "type": "task:completed",
      "payload": {
        "task_id": "task-123",
        "status": "completed",
        "result": {
          "vulnerabilities": 5,
          "scan_time": 120
        }
      }
    },
    "task_failed": {
      "type": "task:failed",
      "payload": {
        "task_id": "task-123",
        "error": "扫描超时",
        "details": "目标服务器响应超时"
      }
    },
    "stage_update": {
      "type": "stage:update",
      "payload": {
        "task_id": "task-123",
        "stage": "info_collection",
        "data": {
          "status": "completed",
          "duration": 30.5
        }
      }
    },
    "subgraph_progress": {
      "type": "subgraph:progress",
      "payload": {
        "task_id": "task-123",
        "subgraph_type": "planning",
        "status": "running",
        "progress": 50
      }
    },
    "tool_execution": {
      "type": "tool:execution",
      "payload": {
        "task_id": "task-123",
        "tool_name": "nmap",
        "status": "running",
        "output": "Starting Nmap scan..."
      }
    },
    "vulnerability_found": {
      "type": "vulnerability_found",
      "payload": {
        "task_id": "task-123",
        "vulnerability": {
          "name": "XSS漏洞",
          "severity": "high",
          "url": "http://example.com/search?q=test"
        }
      }
    },
    "scan_started": {
      "type": "scan_started",
      "payload": {
        "task_id": "task-123",
        "target": "http://example.com",
        "scan_type": "full"
      }
    },
    "notification": {
      "type": "new_notification",
      "payload": {
        "id": 1,
        "title": "扫描完成",
        "message": "任务task-123已完成",
        "type": "scan-complete"
      }
    },
    "ai_message": {
      "type": "ai_message",
      "payload": {
        "conversation_id": "conv-123",
        "message": "我正在分析目标...",
        "type": "text"
      }
    },
    "ai_progress": {
      "type": "progress",
      "payload": {
        "stage": "信息收集",
        "progress": 30,
        "details": "正在收集子域名信息"
      }
    },
    "ai_decision": {
      "type": "decision",
      "payload": {
        "decision_id": "dec-123",
        "question": "发现多个子域名，是否继续扫描？",
        "options": ["继续扫描", "仅扫描主域名", "取消"]
      }
    }
  }
}
